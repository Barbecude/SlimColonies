    "objectives":  [
                       {
                           "type":  "slimcolonies:dialogue",
                           "target":  0,
                           "text":  "Eh! Ada yang luar biasa nih - kristalku langsung bergetar kenceng pas kamu masuk! Ada aura sihir kuno yang kuat banget di deket sini... Kamu nggak sengaja nemu Sacred Scroll of Regeneration pas lagi petualang nggak? Kertas tua yang rasanya anget pas dipegang dan wangi lavender? Sihir itu udah lama banget ilang. Kebetulan dokter desa kita lagi kewalahan banget ngurusin wabah flu di desa. Kalau kamu punya scroll itu, tolong langsung kasihin ke $1 ya! Itu bakal nyelametin banyak warga!",
                           "options":  [
                                           {
                                               "answer":  "Kayaknya aku punya scroll yang begitu deh...",
                                               "result":  {
                                                              "type":  "slimcolonies:advanceobjective",
                                                              "go-to":  1
                                                          }
                                           },
                                           {
                                               "answer":  "Wah, aku belum pernah nemu barang kayak gitu sih.",
                                               "result":  {
                                                              "type":  "slimcolonies:return"
                                                          }
                                           },
                                           {
                                               "answer":  "Sori ya, kayaknya aku belum bisa bantu soal ini.",
                                               "result":  {
                                                              "type":  "slimcolonies:cancel"
                                                          }
                                           }
                                       ]
                       },
                       {
                           "type":  "slimcolonies:delivery",
                           "details":  {
                                           "target":  1,
                                           "item":  {
                                                        "id":  "slimcolonies:scroll_buff"
                                                    },
                                           "next-objective":  2
                                       }
                       },
                       {
                           "unlocks-rewards":  [
                                                   0,
                                                   1,
                                                   2,
                                                   3
                                               ],
                           "type":  "slimcolonies:dialogue",
                           "target":  1,
                           "text":  "Astaga... ini beneran...? Aku cuma pernah baca di buku kuno dan nggak nyangka bisa liat langsung... Rasanya mau nangis! Kamu tau nggak artinya ini apa? Semua pasien yang lagi sakit parah minggu ini bisa langsung sembuh! Aku pakai sekarang juga ya. Aku tau barang selangka ini nggak ada gantinya, tapi tolong terima hadiah dariku ini ya. Makasih banyak udah peduli sama desa kita!",
                           "options":  [
                                           {
                                               "answer":  "Semoga warga cepet sembuh ya! Kerja bagus, Dok!",
                                               "result":  {
                                                              "type":  "slimcolonies:advanceobjective",
                                                              "go-to":  3
                                                          }
                                           },
                                           {
                                               "answer":  "Ada lagi yang bisa kubantu nggak?",
                                               "result":  {
                                                              "type":  "slimcolonies:dialogue",
                                                              "text":  "Tau ada orang sebaik kamu yang jagain desa kita aja udah bikin tenang kok. Udah sana lanjut lagi - kamu udah banyak banget bantuin hari ini. Makasih banyak ya, beneran deh!",
                                                              "options":  [
                                                                              {
                                                                                  "answer":  "Tolong rawat warga baik-baik ya. Makasih!",
                                                                                  "result":  {
