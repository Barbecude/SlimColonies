    "objectives":  [
                       {
                           "type":  "slimcolonies:dialogue",
                           "target":  0,
                           "text":  "Eh, sini masuk-masuk! Dari tadi aku dengerin penjaga Tavern ngomel-ngomel mulu - katanya tukang bangunan kita ngilang di tengah kerjaan padahal atap Tavern masih bocor. Kasian sih dua-duanya. Aku kepikiran mau bikin Worker-Where-Are-You Scroll biar tukang bangunannya nyala dan gampang dicari! Kamu bisa bantuin kumpulin bahannya nggak?",
                           "options":  [
                                           {
                                               "answer":  "Boleh banget! Butuh bahan apa aja nih?",
                                               "result":  {
                                                              "type":  "slimcolonies:dialogue",
                                                              "text":  "Mantap! Aku butuh 3 Teleport Scroll, 6 Glowstone Dust, sama 2 lembar Kertas (Paper). Lumayan sih bahannya, tapi daripada penjaga Tavern ngomel seharian kan!",
                                                              "options":  [
                                                                              {
