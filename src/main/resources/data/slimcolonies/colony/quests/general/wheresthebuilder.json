                                       ]
                       },
                       {
                           "type":  "slimcolonies:dialogue",
                           "target":  0,
                           "text":  "Pas banget! Scroll-nya udah beres. Bentar ya... [mengangkat scroll sambil merem] ...nah, beres! Sekarang tukang bangunanmu udah ada efek cahaya-cahaya dikit di badannya. Coba cari dia lagi ngumpet di mana, aku tunggu di sini ya!",
                           "options":  [
                                           {
                                               "answer":  "Siap! Aku cari dia dulu terus lapor ke sini.",
                                               "result":  {
                                                              "type":  "slimcolonies:advanceobjective",
                                                              "go-to":  6
                                                          }
                                           }
                                       ]
                       },
                       {
                           "type":  "slimcolonies:dialogue",
                           "target":  1,
                           "text":  "Waduh! Ketauan deh! Plis, plis banget jangan bilang siapa-siapa ya! Aku sengaja ngumpet bentar di ruang bawah tanah gudang tiap abis kerja. Cuma di sini tempat paling tenang di desa tanpa ada yang bawel nyuruh-nyuruh tiap lima menit. Aku TAU kok soal atap Tavern itu, nggak lupa beneran deh! Cuma butuh narik napas bentar doang. Kamu ngerti kan? Titip makasih ya buat Enchanter, tapi rahasiain tempat ngumpetku ini ya!",
                           "options":  [
                                           {
                                               "answer":  "Aman, rahasiamu terjaga kok. Istirahat dulu aja!",
                                               "result":  {
                                                              "type":  "slimcolonies:advanceobjective",
                                                              "go-to":  7
                                                          }
                                           },
                                           {
                                               "answer":  "Paham banget kok. Aku nggak bakal bocorin ke siapa-siapa.",
                                               "result":  {
                                                              "type":  "slimcolonies:dialogue",
                                                              "text":  "Duh, makasih banyak pengertiannya! Besok pagi-pagi buta langsung kubenerin atap Tavern-nya, janji! Sekarang mumpung masih ada sisa waktu sepuluh menit, aku lanjut rebahan bentar ya. Makasih banget lho!",
                                                              "options":  [
                                                                              {
                                                                                  "answer":  "Selamat istirahat ya, kamu udah kerja keras!",
                                                                                  "result":  {
                                                                                                 "type":  "slimcolonies:advanceobjective",
                                                                                                 "go-to":  7
                                                                                             }
                                                                              }
                                                                          ]
                                                          }
                                           }
                                       ]
                       },
                       {
                           "unlocks-rewards":  [
                                                   0,
                                                   1,
                                                   2,
                                                   3,
