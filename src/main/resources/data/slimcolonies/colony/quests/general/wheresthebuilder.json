                       {
                           "type":  "slimcolonies:dialogue",
                           "target":  0,
                           "text":  "Sip, bahannya udah pas! Aku racik scroll-nya dulu ya - butuh waktu bentar biar mantap. Nanti ngobrol sama aku lagi kalau udah siap!",
                           "options":  [
                                           {
                                               "answer":  "Santai aja, nanti aku balik lagi!",
                                               "result":  {
